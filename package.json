{
  "name": "zurich-meets-tanzania-website",
  "version": "3.33.1",
  "description": "This is the website for the non profit organization \"zurich - meets - tanzania\".",
  "homepage": "https://www.zurich-meets-tanzania.com",
  "author": "Timon Fiedler",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timon-D3v/Zurich-meets-Tanzania.git"
  },
  "bugs": {
    "url": "https://github.com/Timon-D3v/Zurich-meets-Tanzania/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "node ./dist/server/server.mjs",
    "dev": "docker compose -f ./dev/compose.yaml up -d  && ng serve --port=8080",
    "backup": "MODE=backup ng serve --port=8080",
    "stop": "docker compose -f ./dev/compose.yaml down",
    "build": "ng build && sh dockerize.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "npx prettier --write \"src/**/*.{ts,html,scss}\"",
    "fmt": "npm run format",
    "prettier": "npx prettier",
    "stripe": "stripe listen --forward-to localhost:8080/webhooks/stripe --all-snapshot"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "delivapi-client": "^2.1.0",
    "dotenv": "^18.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "mysql2": "^3.23.2",
    "nodemailer": "^10.0.10",
    "rxjs": "~7.8.0",
    "stripe": "^23.0.0",
    "tianji-client-sdk": "^1.5.0",
    "timonjs": "^2.1.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.1",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@types/compression": "^1.8.1",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jasmine": "~5.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "~24.13.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "charity",
    "medical",
    "tanzania",
    "zurich",
    "switzerland",
    "zurich-meets-tanzania",
    "non-profit",
    "ngo",
    "website",
    "donate",
    "nodejs",
    "express",
    "full-stack",
    "blog",
    "typescript",
    "scss",
    "angular",
    "angular-ssr"
  ],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true
  }
}
